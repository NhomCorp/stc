<mxfile host="65bd71144e">
    <diagram id="menu_overview" name="1. Bản Đồ Các Việc Trên Sheet">
        <mxGraphModel dx="862" dy="709" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#f1f5f9" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m1_title" value="⚡ BẢN ĐỒ PHÂN CHIA TỪNG VIỆC TRÊN GOOGLE SHEETS&#10;(Bấm vào từng Tab bên dưới để xem luồng chi tiết từng việc theo phong cách Node n8n)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=17;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="850" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="m1_root" value="💎 Google Sheets Engine&#10;&lt;b style=&quot;font-size:14px;color:#0f172a;&quot;&gt;Menu &amp; Sheet Triggers&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;onOpen() / CRUD / Quét Mail / Menu Bar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff6d5a;strokeWidth=2;arcSize=15;align=center;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="50" y="360" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g0" value="🌱 VIỆC 1: KHỞI TẠO THÁNG &amp; MỤC LỤC&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Clone Template_Log &amp; Template_Report&lt;br&gt;• Khóa ô B1 &amp; Cấu trúc bảng Mục Lục&lt;br&gt;• Gắn link Bao Cao v2 &amp; Ẩn Shard&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#10b981;&quot;&gt;👉 Xem chi tiết tại Tab 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="90" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g1" value="👁️ VIỆC 2: VIEW THÁNG (UX GỌN NHẸ)&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Xem nhanh chỉ đọc: View_Log / View_Report&lt;br&gt;• Mở sửa Shard gốc khi cần sửa tay&lt;br&gt;• Ẩn Shard giữ bảng tính luôn gọn gàng&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#0288d1;&quot;&gt;👉 Xem chi tiết tại Tab 3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="210" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g2" value="📊 VIỆC 3: LÀM MỚI BÁO CÁO (REBUILD)&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Tháng đang mở / Các tháng Dirty&lt;br&gt;• Tất cả tháng (gõ xác nhận ALL)&lt;br&gt;• Lọc sạch CHECK → Link Bao Cao v2&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#ec4899;&quot;&gt;👉 Xem chi tiết tại Tab 4&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ec4899;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="330" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g3" value="🔄 VIỆC 4: FORMAT &amp; DATA LOG&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Đồng bộ Format từ Template_Log&lt;br&gt;• Dò lệch tháng &amp; Cấp mã MAN_&lt;br&gt;• Di chuyển dòng &amp; Ghi vết Log_Chuyen&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#f59e0b;&quot;&gt;👉 Xem chi tiết tại Tab 5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="450" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g4" value="📧 VIỆC 5: QUÉT MAIL &amp; META ADS&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Quét Mail ngân hàng thủ công&lt;br&gt;• Quét Meta Billing &amp; bù charge thiếu mail&lt;br&gt;• Sidebar cài đặt lịch Cron hằng ngày&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#06b6d4;&quot;&gt;👉 Xem chi tiết tại Tab 6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#06b6d4;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="570" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_g5" value="⚙️ VIỆC 6: CẤU HÌNH &amp; CỨU HỘ&#10;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;• Dialog cấu hình AI Keys, Model, Prompt&lt;br&gt;• Cứu hộ công thức chuẩn Bao Cao v2&lt;br&gt;• Cứu hộ công thức Tóm tắt_v2 (VSTACK)&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#8b5cf6;&quot;&gt;👉 Xem chi tiết tại Tab 7&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="380" y="690" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m1_e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="m1_root" target="m1_g0" edge="1">
                    <mxGeometry relative="1" as="geometry">
