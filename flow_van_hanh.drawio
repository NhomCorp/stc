    <diagram id="month_creation_toc" name="2. Việc 1 - Tạo Tháng &amp; Mục Lục">
        <mxGraphModel dx="862" dy="709" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" background="#f1f5f9" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="toc_title" value="⚡ VIỆC 1: QUY TRÌNH KHỞI TẠO THÁNG MỚI &amp; THIẾT KẾ BẢNG MỤC LỤC&#10;(Tự động clone từ Template, bảo vệ ô B1, liên kết Hyperlink và giấu Shard gọn gàng)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=17;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="950" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="n_detect" value="⚡ Detection Trigger&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;Phát hiện ngày GD mới&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Từ Bot Telegram / Quét Mail / Meta / Sửa tay&lt;br&gt;Parse thành mã tháng: MM_YYYY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff6d5a;strokeWidth=2;arcSize=15;align=center;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="50" y="110" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_check_exist" value="🔀 Router Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;getOrCreateMonthSheets()&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Đã có Log_MM_YYYY &amp; Report_MM_YYYY?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=2;arcSize=15;align=center;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="360" y="110" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_clone_log" value="📄 Template Cloner Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;1. Khởi tạo Log_MM_YYYY&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;• Copy từ 'Template_Log' (GID: 192263148)&lt;br&gt;• Điền A1:B1 = ['Thu Chi tháng', 'MM/yyyy']&lt;br&gt;• protectMonthLogB1_(): Khóa cứng ô B1&lt;br&gt;• Chứa sẵn Dummy Row ở cuối bảng&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="690" y="60" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_clone_rpt" value="📄 Template Cloner Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;2. Khởi tạo Report_MM_YYYY&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;• Copy từ 'Template_Report' (GID: 56513848)&lt;br&gt;• Điền A1:B1 = ['Báo cáo tháng:', 'MM/yyyy']&lt;br&gt;• Gán D1 = '⚠ Chưa nấu báo cáo lần đầu'&lt;br&gt;• Đánh dấu tháng vào Dirty-set&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ec4899;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="680" y="190" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_update_toc" value="📑 TOC Engine Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;ensureMonthInMucLuc_()&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Kiểm tra nếu tháng chưa có trong tab Mục Lục:&lt;br&gt;• Ghi dòng mới: Cột A = 'MM/yyyy' (Text @)&lt;br&gt;• Cột B = =HYPERLINK(&quot;#gid=...&quot;, &quot;Log_MM_YYYY&quot;)&lt;br&gt;• Cột C = =HYPERLINK(&quot;#gid=...&quot;, &quot;Report_MM_YYYY&quot;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="60" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_link_baocao" value="📊 Live Link Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;ensureMonthLinkedOnBaoCao_()&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Gắn dòng liên kết tháng vào tab 'Bao Cao v2'&lt;br&gt;Công thức: ='Report_MM_YYYY'!B3:B6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="190" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_hide_pair" value="🙈 UX Hide Node&#10;&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;hideMonthShardPair_()&lt;/b&gt;&#10;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Tự động ẩn Log_MM_YYYY &amp; Report_MM_YYYY&lt;br&gt;để thanh tab phía dưới không bị tràn ngập!&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;arcSize=15;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="290" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="box_mucluc_spec" value="BẢNG CẤU TRÚC SHEET 'MỤC LỤC' (SHEET_NAMES.MUC_LUC)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;startSize=30;" parent="1" vertex="1">
                    <mxGeometry x="50" y="420" width="680" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="spec_r1" value="Dòng 1: [A1:C1 Merge] '📑 MỤC LỤC — Log &amp; Report theo tháng' (Title màu đậm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;" parent="box_mucluc_spec" vertex="1">
                    <mxGeometry x="20" y="45" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="spec_r2" value="Dòng 2: Header 3 cột: Cột A: 'Tháng' | Cột B: 'Log' | Cột C: 'Report'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontStyle=1;" parent="box_mucluc_spec" vertex="1">
                    <mxGeometry x="20" y="95" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="spec_r3" value="Dòng 3+: Dữ liệu tháng tự động điền (MUC_LUC_DATA_START_ROW = 3):&#10;• Cột A (0): Định dạng chuỗi @: '08/2026', '09/2026' ...&#10;• Cột B (1): Công thức =HYPERLINK(&quot;#gid=2063...&quot;; &quot;Log_09_2026&quot;)&#10;• Cột C (2): Công thức =HYPERLINK(&quot;#gid=1475...&quot;; &quot;Report_09_2026&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;align=left;spacingLeft=15;" parent="box_mucluc_spec" vertex="1">
                    <mxGeometry x="20" y="145" width="640" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="spec_action" value="TÁC VỤ TÁI TẠO MỤC LỤC: rebuildMucLuc()&#10;Khi người dùng bấm Menu '📑 Tái tạo Mục Lục':&#10;1. Xoá sạch nội dung cũ trong tab Mục Lục&#10;2. Quét lại toàn bộ sheet trong Spreadsheet khớp mẫu Log_(\d\d_\d\d\d\d)&#10;3. Tái lập toàn bộ danh sách tháng và nạp lại công thức Hyperlink theo mảng setFormulas()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;align=left;spacingLeft=15;" parent="box_mucluc_spec" vertex="1">
                    <mxGeometry x="20" y="240" width="640" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="box_template_spec" value="BẢNG CẤU TRÚC TEMPLATE_LOG (9 CỘT DUY NHẤT)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=13;startSize=30;" parent="1" vertex="1">
                    <mxGeometry x="770" y="420" width="760" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="tpl_r1" value="Ô A1:B1: 'Thu Chi tháng' | [Ô B1: MM/yyyy] 👉 Được khóa bảo vệ bằng protectMonthLogB1_()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;" parent="box_template_spec" vertex="1">
                    <mxGeometry x="20" y="45" width="720" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="tpl_r2" value="Dòng 2: Header 9 cột (MONTH_LOG_COL):&#10;A: Ngày (dd/MM/yyyy) | B: Phân loại (Thu/Chi) | C: Số tiền (+Thu, -Chi)&#10;D: Nguồn tiền (Ví) | E: Đối tượng | F: Danh mục con | G: Ghi chú&#10;H: Unique Key (TX_...) | I: Status (CHECK:reason,... / Rỗng khi OK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;align=left;spacingLeft=15;" parent="box_template_spec" vertex="1">
                    <mxGeometry x="20" y="95" width="720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="tpl_dummy" value="Dòng 3 (Dummy Row mẫu sẵn có):&#10;Chứa trọn vẹn Format tiền tệ, Căn lề, Font chữ, và Data Validation Dropdown:&#10;• Cột B Dropdown: Thu / Chi&#10;• Cột D Dropdown: Master Ví&#10;• Cột E Dropdown: Master Đối tượng&#10;• Cột F Dropdown: Master Danh mục con&#10;👉 Mọi dòng mới khi append sẽ chèn TRƯỚC Dummy Row và copy 100% thuộc tính này!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;align=left;spacingLeft=15;" parent="box_template_spec" vertex="1">
                    <mxGeometry x="20" y="175" width="720" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="tpl_report" value="Template_Report: Chứa bảng tóm tắt Thu/Chi/Ròng tĩnh sẵn sàng chờ script rebuildReportMonth() nạp số" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;" parent="box_template_spec" vertex="1">
                    <mxGeometry x="20" y="295" width="720" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="n_detect" target="n_check_exist" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec2" value="Chưa có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontStyle=1;" parent="1" source="n_check_exist" target="n_clone_log" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="140"/>
                            <mxPoint x="640" y="115"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ec3" value="Chưa có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ec4899;strokeWidth=2;fontStyle=1;" parent="1" source="n_check_exist" target="n_clone_rpt" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="170"/>
                            <mxPoint x="640" y="245"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ec4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;" parent="1" source="n_clone_log" target="n_update_toc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0288d1;strokeWidth=2;" parent="1" source="n_clone_rpt" target="n_link_baocao" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="n_clone_rpt" target="n_hide_pair" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="990" y="260"/>
                            <mxPoint x="990" y="330"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="menu_view" name="3. Việc 2 - View Tháng">
        <mxGraphModel dx="862" dy="709" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" background="#f1f5f9" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
